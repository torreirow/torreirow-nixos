<section class="flex items-center justify-center min-h-screen">
  <div class="py-10 mx-auto max-w-4xl px-4">
    <div class="max-w-3xl mx-auto">
      <div class="text-center">
        <!-- WvB Logo -->
        <div class="relative flex flex-col items-center mb-8">
          <img src="/custom/wvb-logo-notxt.png" alt="Wereld van Begrip" class="h-32 w-auto mb-6">
          <h1 class="text-5xl font-bold mb-4">
            Onze Overeenkomst
          </h1>
        </div>

        <!-- Uitleg -->
        <div class="prose prose-lg mx-auto mb-12">
          <p class="text-xl text-gray-700 leading-relaxed mb-6">
            Welkom bij het digitale overeenkomsten platform van Wereld van Begrip.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
          Hier kun je veilig en efficiënt digitale documenten ondertekenen en beheren. <br>
            Dit platform garandeert dat jouw documenten volledig onder jouw controle blijven.
          </p>
          <div class="bg-blue-50 border-l-4 border-blue-500 p-6 my-8">
            <p class="text-gray-700">
              <strong>Veilig:</strong> Je documenten worden lokaal opgeslagen op onze servers.<br>
              <strong>Eenvoudig:</strong> Je hoeft alleen je Naam in te vullen en je handtekening te zetten<br>
            </p>
          </div>
        </div>

        <!-- Extra info -->
        <p class="text-sm text-gray-500 mt-8">
        Kom je op deze pagina via een link uit de e-mail?<br/>
        Dan is er helaast iets fout gegaan. <br/><br/>
        Neem contact met met je Wereld van Begrip medewerker.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Keep DocSeal attribution -->
<%= render 'shared/attribution', with_counter: true %>
